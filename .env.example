# ==================== HOMELAB ENVIRONMENT CONFIGURATION ====================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#   vi .env

# ==================== GENERAL ====================

# System timezone - used by all services
# Find yours: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Prague

# Your domain name (used for service URLs like jellyfin.yourdomain.com)
DOMAIN=yourdomain.com

# ==================== USER/PERMISSIONS ====================

# User/group IDs for file ownership (find with: id $USER)
PUID=1000
PGID=1000

# ==================== TRAEFIK (Reverse Proxy) ====================

# Email for Let's Encrypt certificate notifications
ACME_EMAIL=your-email@example.com

# Cloudflare API token for DNS-01 challenge
# Create at: https://dash.cloudflare.com/profile/api-tokens
# Required permissions:
#   - Zone > DNS > Edit
#   - Zone > Zone > Read
# Zone resources: Include > Specific zone > yourdomain.com
CLOUDFLARE_API_KEY=your_cloudflare_scoped_api_token_here

# ==================== VPN (Gluetun - Custom OpenVPN) ====================

# OpenVPN credentials from your VPN provider (may differ from website login)
# Save the generated profile to arr/gluetun/custom.ovpn; it selects the server and protocol
OPENVPN_USER=your_openvpn_username
OPENVPN_PASSWORD=your_openvpn_password

# ==================== HOMARR ====================

# Required: 64 hexadecimal characters (generate once with: openssl rand -hex 32)
# Keep this key unchanged and store a copy securely for restores.
HOMARR_SECRET_ENCRYPTION_KEY=

# ==================== RESTIC BACKUP ====================

# REST server host (IP or hostname of your rest-server)
RESTIC_REST_HOST=192.168.1.100

# REST server port
RESTIC_REST_PORT=8000

# Repository encryption password (generate with: openssl rand -base64 32)
# CRITICAL: Back this up! Required to decrypt your backups
RESTIC_PASSWORD=your_restic_repository_password

# REST server authentication credentials
RESTIC_REST_USERNAME=homelab
RESTIC_REST_PASSWORD=your_rest_server_password

# ==================== DIUN (Image Update Notifications) ====================

# Diun watches all container images and sends an ntfy notification when a newer
# image is available. It never updates anything — you update manually once a
# release has proven stable.
#
# ntfy topic to publish notifications to. Pick a LONG, RANDOM name: public
# ntfy.sh topics are unauthenticated, so anyone who guesses the topic name can
# read your notifications.
DIUN_NTFY_TOPIC=change-me-to-a-long-random-topic

# Optional: self-hosted ntfy server (defaults to https://ntfy.sh)
#DIUN_NTFY_ENDPOINT=https://ntfy.sh
